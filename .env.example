# Configuración de producción para Fly.io
# Copia este archivo a .env.production y completa los valores

# Host y puerto
HOST=0.0.0.0
PORT=8050

# Tastytrade OAuth (opcional - para datos en tiempo real)
# TASTYTRADE_CLIENT_ID=your_client_id
# TASTYTRADE_CLIENT_SECRET=your_client_secret
# TASTYTRADE_REDIRECT_URI=your_redirect_uri
# TASTYTRADE_REFRESH_TOKEN=your_refresh_token

# dxFeed (opcional - para datos en tiempo real)
# DXFEED_HOST=your_dxfeed_host
# DXFEED_PORT=your_dxfeed_port